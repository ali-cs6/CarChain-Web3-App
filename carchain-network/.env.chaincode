# =====================================================
# FABRIC ENVIRONMENT VARIABLES FOR CHAINCODE LIFECYCLE
# =====================================================

# Fabric Paths
export FABRIC_BIN_PATH="$HOME/Documents/carChainV2/carchain-network/bin"
export FABRIC_CFG_PATH="$HOME/Documents/carChainV2/carchain-network/config"

# Channel Configuration
export CHANNEL_NAME="carchain-channel"
export CHAINCODE_NAME="carchain"
export CHAINCODE_VERSION="1.0.0"
# export CHAINCODE_SEQUENCE="1"
# export CHAINCODE_SEQUENCE="2"
# export CHAINCODE_SEQUENCE="3"
export CHAINCODE_SEQUENCE="4"

# Organization & MSP
export CORE_PEER_LOCALMSPID="UsersOrgMSP"
export MSPDIR="$HOME/Documents/carChainV2/carchain-network/organizations/usersorg/admin/msp"

# Peer 0 Configuration
export CORE_PEER_ADDRESS="localhost:7051"
export CORE_PEER_TLS_ENABLED="true"
export CORE_PEER_TLS_ROOTCERT_FILE="$HOME/Documents/carChainV2/carchain-network/peers/peer0/tls/tlscacerts/ca.crt"
export CORE_PEER_MSPCONFIGPATH="$HOME/Documents/carChainV2/carchain-network/organizations/usersorg/admin/msp"

# Orderer Configuration
export ORDERER_CA="$HOME/Documents/carChainV2/carchain-network/orderer/tls/tlscacerts/ca.crt"
export ORDERER_ADDRESS="localhost:7050"

# Chaincode Source & Package
export CHAINCODE_PATH="$HOME/Documents/carChainV2/carchain-network/chaincode/carChain"
# export CHAINCODE_PACKAGE_PATH="$HOME/Documents/carChainV2/carchain-network/chaincode-packages"
# export CHAINCODE_PACKAGE_ID="carchain_1:32a1401ae29d1319e899efe82aa4950b9cc45bd853177e5ab1dee3f252addc43"
# export CHAINCODE_LABEL="carchain_1"

# 2nd try
# export CHAINCODE_PACKAGE_ID="carchain_2:eaed57cbf0e0cef105c8a6bc2139036e41e859f3636ddcbdd5ebad9f724d82b9"
# export CHAINCODE_LABEL="carchain_2"

# 3rd try
# export CHAINCODE_PACKAGE_ID="carchain_3:82cad53ccaa35825ce98ef5798c5764a289b6970aac04882da5f58f153315dd3"
# export CHAINCODE_LABEL="carchain_3"

# 4th try
export CHAINCODE_PACKAGE_ID="carchain_4:188b53ce1a67a6674d7568e74b2d8bcb0009e92a148a69f39d19a65fb557e8cc"
export CHAINCODE_LABEL="carchain_4"

# Add Fabric binaries to PATH
export PATH="$FABRIC_BIN_PATH:$PATH"

# Enable debug logging (optional)
export FABRIC_LOGGING_SPEC="INFO"
